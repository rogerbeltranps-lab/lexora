    {
      "term": "turn in",
      "type": "Phrasal verb",
      "ipa": "/tɝn ɪn/",
      "senses": [
        {
          "definition": "Go to bed",
          "catalan": "anar-se'n a dormir",
          "example": "I was tired, so I turned in early."
        },
        {
          "definition": "Submit something",
          "catalan": "lliurar",
          "example": "Please turn in your homework."
        },
        {
          "definition": "Report or surrender someone to authorities",
          "catalan": "denunciar; lliurar",
          "example": "They turned the suspect in."
        }
      ]
    },
