  "entries": [
    {
      "term": "come across",
      "type": "Phrasal verb",
      "ipa": "/kʌm əˈkrɔs/",
      "senses": [
        {
          "definition": "Meet or find unexpectedly",
          "catalan": "trobar per casualitat",
          "example": "I came across an old friend."
        },
        {
          "definition": "Seem or be perceived in a particular way",
          "catalan": "semblar; transmetre una impressió",
          "example": "She comes across as confident."
        }
      ]
    },
    {
